---
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Logo from '../ui/Logo.astro';
---

<header class='py-6 sticky top-0 bg-white z-50 md:py-4 md:h-15.5'>
  <Container
    class='flex justify-between gap-2 items-center [&_>a:first-child]:text-neutral-900'
  >
    <Logo />
    <nav
      class:list={[
        'md:absolute md:w-full md:bottom-0 md:h-[calc(100vh-3.875rem)]',
        'md:top-15.5 md:left-0 md:right-0 md:bg-white md:px-container-mobile',
        'md:py-3 md:before:content-["Меню"] md:before:block md:before:text-body-2xl',
        'md:before:text-neutral-900 md:before:font-medium md:before:mb-3',
        'md:transition-transform md:duration-300 md:translate-x-[-100vw]',
      ]}
    >
      <ul
        class:list={[
          'flex gap-10 [&_a]:hover:opacity-55 [&_a]:transition-opacity [&_a]:duration-300 md:flex-col',
          'md:gap-3 md:[&_a]:text-body-2xl',
        ]}
      >
        <li><a href='#about'>Обо мне</a></li>
        <li><a href='#specialization'>Направления</a></li>
        <li><a href='#benefits'>Почему я</a></li>
        <li><a href='#rating'>Отзывы</a></li>
        <li><a href='#pricing'>Цены</a></li>
      </ul>
    </nav>
    <Button
      href='https://t.me/choosethelight'
      type='primary'
      class='py-3.5 md:hidden'>Записаться</Button
    >
    <button
      class:list={[
        'burger-button flex-col justify-between w-8 h-5 focus:outline-none hidden md:flex transition-transform duration-300',
        '[&.opened_span:nth-child(1)]:rotate-45 [&.opened_span:nth-child(2)]:-rotate-45',
        '[&.opened_span:nth-child(3)]:hidden [&.opened_span]:absolute [&.opened_span]:top-0',
        '[&.opened_span]:bottom-0 [&.opened_span]:left-0 [&.opened_span]:right-0 [&.opened_span]:m-auto',
        'relative active:scale-[0.8]',
      ]}
      aria-label='Open Menu'
    >
      <span class='w-full h-1 bg-neutral-900 rounded'></span>
      <span class='w-full h-1 bg-neutral-900 rounded'></span>
      <span class='w-full h-1 bg-neutral-900 rounded'></span>
    </button>
  </Container>
</header>

<script>
  const burgerButton = document.querySelector('.burger-button');
  const headerNav = document.querySelector('header nav');
  const links = document.querySelectorAll('header nav ul a');

  burgerButton?.addEventListener('click', () => {
    headerNav?.classList.toggle('md:translate-x-[-100vw]');
    burgerButton.classList.toggle('opened');
  });

  links.forEach((link) => {
    link.addEventListener('click', () => {
      headerNav?.classList.toggle('md:translate-x-[-100vw]');
      burgerButton?.classList.toggle('opened');
    });
  });
</script>
