---
import { Swiper, SwiperPagination, SwiperWrapper } from 'astro-swiper';
---

<Swiper
  options={{
    slidesPerView: 3,
    spaceBetween: 23,
    loop: true,
    navigation: {
      nextEl: '.rating-slider-button-right',
      prevEl: '.rating-slider-button-left',
    },
    autoplay: {
      delay: 5_000,
    },
    pagination: {
      el: '.swiper-pagination',
      enabled: true,
      clickable: true,
    },
    breakpoints: {
      1: {
        slidesPerView: 1,
      },
      769: {
        slidesPerView: 2,
      },
      1226: {
        slidesPerView: 3,
      },
    },
    autoHeight: true,
  }}
  class='rating-slider'
>
  <SwiperWrapper class='mb-4'>
    <slot />
  </SwiperWrapper>
  <SwiperPagination />
</Swiper>

<style>
  .rating-slider :global(.swiper-pagination) {
    position: static;
  }

  .rating-slider :global(.swiper-pagination-bullet-active) {
    background: var(--color-primary-900);
  }
</style>
