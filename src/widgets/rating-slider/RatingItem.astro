---
import { SwiperSlide } from 'astro-swiper';
import StarsIcon from '../../assets/icons/stars.svg';

interface Props {
  name: string;
  specialization: string;
}

const { name, specialization } = Astro.props;
---

<SwiperSlide
  class='py-8 px-7 border border-secondary-600 rounded-[28px] bg-white shadow-xs/10'
>
  <StarsIcon class='mb-2' />
  <div class='mb-1 font-semibold text-neutral-900 text-body-lg'>{name}</div>
  <div class='mb-5 text-neutral-400'>{specialization}</div>
  <p class='text-neutral-300'>
    <slot />
  </p>
</SwiperSlide>
