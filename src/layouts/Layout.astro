---
import '../global.css';
import { Font } from 'astro:assets';
import { SEO } from 'astro-seo';

const title = 'Елизавета Ювати';
const description =
  'Помогаю поступить на бюджет, закрыть пробелы и обрести уверенность в своих силах. Бережно, системно и без зубрёжки — с нуля до максимума.';
---

<!doctype html>
<html lang='ru'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <link rel='icon' href='/favicon.ico' />
    <link rel='sitemap' href='/sitemap-index.xml' />
    <meta name='generator' content={Astro.generator} />
    <Font cssVariable='--font-inter' preload />
    <Font cssVariable='--font-playfair-display' preload />
    <SEO
      title={title}
      description={description}
      canonical={Astro.url.href}
      openGraph={{
        basic: {
          title,
          type: 'website',
          image: new URL('/hero-image.png', Astro.site).toString(),
          url: Astro.url.href,
        },
        optional: {
          description,
        },
      }}
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  import { Observer } from 'tailwindcss-intersect/observer';

  const initObserver = () => {
    Observer.start();
  };

  document.addEventListener('DOMContentLoaded', initObserver);
  document.addEventListener('astro:page-load', initObserver);
</script>
