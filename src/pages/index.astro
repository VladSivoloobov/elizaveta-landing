---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Header from '../widgets/Header.astro';
import HeroSection from '../sections/HeroSection.astro';
import AboutSection from '../sections/AboutSection.astro';
import SpecializationSection from '../sections/SpecializationSection.astro';
import BenefitsSection from '../sections/BenefitsSection.astro';
