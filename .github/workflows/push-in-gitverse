name: Mirror to GitHub
on: [push]
jobs:
  mirror:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v3
        with:
          fetch-depth: 0
      - name: Push to GitHub
        run: |
          git remote add github https://${{ secrets.GH_MIRROR_ACTOR }}:${{ secrets.GH_MIRROR_TOKEN }}@://github.com{{ secrets.GH_MIRROR_ACTOR }}/${{ secrets.GH_MIRROR_REPO }}.git
          git push --force --prune github "+refs/remotes/origin/*:refs/heads/*" --tags
